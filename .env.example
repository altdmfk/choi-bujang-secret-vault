# ==============================================================================
# BYTE BACK / 케셰브 이동용 환경 설정 템플릿 (.env.example)
# 실제 비밀값(API 키, 데이터베이스 키 등)은 본 파일에 기록하지 마세요.
# 새 환경에서는 이 파일을 .env.local 로 복사한 뒤 필요한 설정만 채워 넣으세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 케셰브 (on-client) 기본 로컬 실행 설정
# (기본 실행 시에는 환경변수 없이도 기본값으로 즉시 기동됩니다.)
# ------------------------------------------------------------------------------
# 로컬 웹 서버 리스닝 포트 (기본값: 5189)
ON_PORT=5189

# AI 모델 허용 목록 식별자 (기본값: aleph/auto)
ON_AI_MODEL=aleph/auto

# ------------------------------------------------------------------------------
# 2. 케셰브 (on-client) 취약점 조회(20단계) 및 외부 연결 설정 (선택적)
# (취약점 조회 시 대상 프로젝트의 절대경로를 설정합니다.)
# ------------------------------------------------------------------------------
# 의존성 패키지(package-lock.json) 취약점 스캔 대상 프로젝트 절대경로
# 예: C:\Users\user\Desktop\task\choi-bujang-secret-vault
ON_PROJECT_DIRECTORY=

# OSV 취약점 공개 조회 승인 패키지 목록 (JSON 배열 형식, 미지정 시 빈 배열)
# 예: ["express", "lodash"] (승인 패키지가 없으면 외부 조회를 건너뜁니다)
ON_APPROVED_PUBLIC_PACKAGES=[]

# ------------------------------------------------------------------------------
# 3. 배포 자료실 API (1~12단계 / Vercel 배포 시 필요)
# (로컬 케셰브 기본 실행에는 불필요하며, Vercel/Supabase 배포 시에만 주입)
# ------------------------------------------------------------------------------
# Supabase 백엔드 접속 URL
SUPABASE_URL=https://<your-supabase-project>.supabase.co

# Supabase 서버 서비스 롤 키 (절대 공개 저장소에 커밋하지 마세요)
SUPABASE_SECRET_KEY=

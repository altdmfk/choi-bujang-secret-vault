# ==============================================================================
# 케셰브 (on-client) 이동용 환경 설정 템플릿 (.env.example)
# 실제 비밀값(API 키 등)은 본 파일에 기록하지 마세요.
# ==============================================================================
# [설정 적용 및 실행 안내]
# 서버는 순수 표준 라이브러리로 구동되므로 .env.local 을 자동 로드하지 않습니다.
# 지원하는 실행 방법 2가지 중 하나를 선택하여 설정을 적용하세요:
#
# 방법 1 (PowerShell 환경변수 직접 주입 - 권장):
#   $env:ON_PORT = "5189"
#   $env:ON_PROJECT_DIRECTORY = (Get-Item ..).FullName
#   $env:ON_APPROVED_PUBLIC_PACKAGES = "[]"
#   npm start
#
# 방법 2 (Node.js 24 내장 --env-file 플래그 사용):
#   본 파일을 on-client/.env.local 로 복사한 뒤:
#   node --env-file=.env.local src/server.mjs
# ==============================================================================

# 로컬 웹 서버 리스닝 포트 (기본값: 5189)
ON_PORT=5189

# AI 모델 허용 목록 식별자 (기본값: aleph/auto)
ON_AI_MODEL=aleph/auto

# 의존성 패키지(package-lock.json) 취약점 스캔 대상 프로젝트 절대경로 (미지정 시 자동 탐지)
ON_PROJECT_DIRECTORY=

# OSV 취약점 공개 조회 승인 패키지 목록 (JSON 배열 형식, 미지정 시 승인 패키지 8종 자동 적용)
ON_APPROVED_PUBLIC_PACKAGES=["@supabase/supabase-js","jose","tslib","@supabase/auth-js","@supabase/functions-js","@supabase/postgrest-js","@supabase/realtime-js","@supabase/storage-js"]

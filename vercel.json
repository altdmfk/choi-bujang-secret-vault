{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/notes/:id", "destination": "/api/notes?id=:id" },
    { "source": "/notes/:id", "destination": "/api/notes?id=:id" },
    { "source": "/notes", "destination": "/api/notes" },
    { "source": "/api/notices/:id", "destination": "/api/notices?id=:id" },
    { "source": "/notices/:id", "destination": "/api/notices?id=:id" },
    { "source": "/notices", "destination": "/api/notices" }
  ]
}
